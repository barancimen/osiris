# Copy this file to .env in the same folder and fill in what you have.
# Anything left empty is simply skipped. .env is never committed.

# Tweets, Reddit threads and paper abstracts from https://scry.io
SCRY_API_KEY=

# GitHub repos and gists. A token with no scopes is enough for public repos.
GITHUB_TOKEN=

# Tweets Scry doesn't have, from twitterapi.io. Billed per tweet.
# The page only uses it when you tick "Allow twitterapi.io".
TWITTERAPI_IO_KEY=

# 10,000 Stack Exchange API calls a day instead of 300
STACKEXCHANGE_KEY=

# Your own OpenAlex budget instead of the shared one
OPENALEX_API_KEY=
